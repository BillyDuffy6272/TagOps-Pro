# Copy to .env.local and fill in with your Supabase project's values
# (Project Settings → API in the Supabase dashboard). Never commit .env.local —
# it's git-ignored. Both values are safe to expose in the client bundle: the
# anon key only ever acts within what Row-Level Security allows.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
